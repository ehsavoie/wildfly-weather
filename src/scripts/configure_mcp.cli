/subsystem=undertow/server=default-server/http-listener=default:write-attribute(name=read-timeout, value=0)
/subsystem=undertow/server=default-server/http-listener=default:write-attribute(name=write-timeout, value=0)
/subsystem=logging/logger=org.jboss.weld:add(level=INFO)
/subsystem=logging/logger=org.wildfly.extension.mcp.injection:add(level=DEBUG)
/subsystem=wasm/wasm-tool=chicory:add(path="greet.wasm", relative-to="jboss.server.data.dir")
/subsystem=wasm/wasm-tool=dice:add(path="roll-dice.wasm", relative-to="jboss.server.data.dir")
/subsystem=wasm/wasm-tool=pizza:add(path="hawaiian-pizza.wasm", relative-to="jboss.server.data.dir")
